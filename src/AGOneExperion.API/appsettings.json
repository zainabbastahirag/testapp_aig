{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "EnableSwagger": true,
  "Experion": {
    "BlobConnectionString": "DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net",
    "ActivityContainerName": "experion-activity",
    "ProfileContainerName": "experion-profiles",

    "OpenAiEndpoint": "https://YOUR_OPENAI_RESOURCE.openai.azure.com/",
    "OpenAiApiKey": "YOUR_AZURE_OPENAI_KEY",
    "ChatModel": "gpt-4.1",

    "EmbeddingEndpoint": "",
    "EmbeddingApiKey": "",
    "EmbeddingModel": "text-embedding-3-small",

    "SearchEndpoint": "https://YOUR_SEARCH_RESOURCE.search.windows.net",
    "SearchApiKey": "YOUR_SEARCH_ADMIN_KEY",
    "DefaultKbIndex": "experion-kb",
    "SearchTopK": 5,

    "MaxActivityEventsPerUser": 500,
    "MaxFragmentTokens": 4000,
    "MaxOutputTokens": 2000,
    "MaxRecommendations": 3,
    "ResponseLanguage": "en",
    "ProactiveNudgeAfterEvents": 8
  }
}
