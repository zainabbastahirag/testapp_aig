{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Experion": {
    "DefaultKbIndex": "ag-experion-index",
    "MaxCapturedElements": 50,
    "MaxFragmentTokens": 4000,
    "Model": "gpt-4.1",
    "MaxOutputTokens": 2000,
    "SearchTopK": 5,
    "ResponseLanguage": "en"
  },
  "Storage": {
    "BlobConnectionString": "<YOUR_BLOB_CONNECTION_STRING>",
    "ActivityContainerName": "experion-activity",
    "ConversationContainerName": "experion-conversations"
  },
  "OpenAI": {
    "Endpoint": "<YOUR_AZURE_OPENAI_ENDPOINT>",
    "ApiKey": "<YOUR_AZURE_OPENAI_KEY>",
    "DefaultModel": "gpt-4.1",
    "EmbeddingEndpoint": "<YOUR_EMBEDDING_ENDPOINT>",
    "EmbeddingApiKey": "<YOUR_EMBEDDING_KEY>",
    "EmbeddingModel": "text-embedding-3-small"
  },
  "Search": {
    "Endpoint": "<YOUR_AI_SEARCH_ENDPOINT>",
    "ApiKey": "<YOUR_AI_SEARCH_KEY>"
  },
  "Recommendation": {
    "IdleThresholdSeconds": 30,
    "EventBatchTrigger": 20,
    "MaxSuggestionsPerRequest": 3,
    "CooldownMinutes": 5
  }
}
