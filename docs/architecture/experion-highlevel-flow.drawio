        <!-- Title -->
        <mxCell id="title" value="AG ONE Experion — High-Level End-to-End Flow" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1620" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="User on any website  →  Experion JS Agent  →  AG AI HUB (Cache → Route → Action / LLM)  →  Response back" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="40" y="55" width="1620" height="20" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- Swimlane 1: USER  -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <mxCell id="lane-user" value="USER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontSize=13;fontStyle=1;fontColor=#1E3A8A;align=center;verticalAlign=top;spacingTop=10;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="180" height="980" as="geometry" />
        </mxCell>

        <!-- Swimlane 2: EXPERION SDK -->
        <mxCell id="lane-sdk" value="EXPERION JS AGENT  (frontend SDK)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#60A5FA;fontSize=13;fontStyle=1;fontColor=#1E40AF;align=center;verticalAlign=top;spacingTop=10;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="240" y="100" width="320" height="980" as="geometry" />
        </mxCell>

        <!-- Swimlane 3: AG AI HUB API + ORCHESTRATOR -->
        <mxCell id="lane-api" value="AG AI HUB  —  ExperionController + IExperionService" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=13;fontStyle=1;fontColor=#92400E;align=center;verticalAlign=top;spacingTop=10;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="580" y="100" width="640" height="980" as="geometry" />
        </mxCell>

        <!-- Swimlane 4: INFRA -->
        <mxCell id="lane-infra" value="INFRASTRUCTURE  (Azure)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;fontSize=13;fontStyle=1;fontColor=#0F172A;align=center;verticalAlign=top;spacingTop=10;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="1240" y="100" width="420" height="980" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- Step nodes — USER lane                                   -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <mxCell id="u1" value="① Visits&#10;a website" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3B82F6;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="65" y="160" width="130" height="80" as="geometry" />
        </mxCell>
        <mxCell id="u2" value="② Browses /&#10;circles area /&#10;asks question" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3B82F6;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="65" y="380" width="130" height="80" as="geometry" />
        </mxCell>
        <mxCell id="u3" value="③ Receives&#10;answer or&#10;recommendation" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3B82F6;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="65" y="900" width="130" height="80" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- SDK lane steps                                            -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <mxCell id="s1" value="&lt;b&gt;Boot &amp; Identify&lt;/b&gt;&#10;&#10;• Load tenant config&#10;• Resolve UserID (or anon-id + IP/geo cluster)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontSize=11;fontColor=#1E3A8A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="260" y="160" width="285" height="90" as="geometry" />
        </mxCell>

        <mxCell id="s2" value="&lt;b&gt;Track activity (passive, async)&lt;/b&gt;&#10;&#10;pageview · dwell · click · scroll · forms&#10;Batched POST /events  →  Service Bus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontSize=11;fontColor=#065F46;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="260" y="270" width="285" height="90" as="geometry" />
        </mxCell>

        <mxCell id="s3" value="&lt;b&gt;Trigger event (sync)&lt;/b&gt;&#10;&#10;Circle gesture / idle nudge / chat message&#10;POST /api/experion/process" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontSize=11;fontColor=#1E3A8A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="260" y="385" width="285" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s4" value="&lt;b&gt;Render in UI&lt;/b&gt;&#10;&#10;Sphere · Sidebar · Suggestions · Nudge bubble" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;fontSize=11;fontColor=#4C1D95;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="260" y="900" width="285" height="80" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- API / Orchestrator lane steps                             -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <mxCell id="a0" value="&lt;b&gt;ExperionController&lt;/b&gt;  receives request&#10;( /process · /events · /ask · /feedback · WS /push )" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=11;fontStyle=1;fontColor=#92400E;align=center;verticalAlign=middle;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="600" y="160" width="600" height="50" as="geometry" />
        </mxCell>

        <!-- Step 1 Context Builder -->
        <mxCell id="a1" value="&lt;b&gt;1️ Context Builder&lt;/b&gt;&#10;&#10;• Load Conversation History (per UserID)&#10;• Load User Profile / cohort&#10;• Clean DOM fragment, build normalised query" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;fontSize=11;fontColor=#78350F;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="600" y="230" width="600" height="80" as="geometry" />
        </mxCell>

        <!-- Step 2 Semantic Cache -->
        <mxCell id="a2" value="&lt;b&gt;2️ Semantic Cache  (check FIRST → save tokens)&lt;/b&gt;&#10;&#10;Embed query → vector lookup in AI Search cache index&#10;HIT (≥ threshold) → return cached answer       MISS → continue ↓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontSize=11;fontColor=#065F46;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="600" y="325" width="600" height="80" as="geometry" />
        </mxCell>

        <!-- Step 3 Intent Router -->
        <mxCell id="a3" value="&lt;b&gt;3️ NLP Intent Router&lt;/b&gt;     classifies →  ACTION   ·   GENERATION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;fontSize=11;fontStyle=1;fontColor=#78350F;align=center;verticalAlign=middle;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="600" y="420" width="600" height="50" as="geometry" />
        </mxCell>

        <!-- Step 4a Action Trigger -->
        <mxCell id="a4a" value="&lt;b&gt;4a Action Trigger&lt;/b&gt;&#10;&#10;• Lookup ActionMappings (SQL)&#10;  intent → actionKey&#10;• Publish to Service Bus action-queue&#10;• Worker invokes API / job&#10;• Returns ack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;fontSize=11;fontColor=#7F1D1D;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="600" y="490" width="290" height="160" as="geometry" />
        </mxCell>

        <!-- Step 4b LLM Generation -->
        <mxCell id="a4b" value="&lt;b&gt;4b LLM Generation (RAG)&lt;/b&gt;&#10;&#10;• Embed query&#10;• Retrieve KB chunks (AI Search)&#10;• Build prompt: history + KB + profile&#10;• Call Azure OpenAI GPT-4.1&#10;• Stream response" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;fontSize=11;fontColor=#4C1D95;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="910" y="490" width="290" height="160" as="geometry" />
        </mxCell>

        <!-- Step 5 Persist & Learn -->
        <mxCell id="a5" value="&lt;b&gt;5️ Persist &amp; Learn&lt;/b&gt;&#10;&#10;Conversation History (SQL)   ·   Semantic Cache write-back (AI Search)   ·   Audit log (SQL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;fontSize=11;fontColor=#78350F;align=center;verticalAlign=middle;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="600" y="670" width="600" height="60" as="geometry" />
        </mxCell>

        <!-- Async Mining + Reco -->
        <mxCell id="a6" value="&lt;b&gt;Async lane — Activity Mining + Recommendation&lt;/b&gt;&#10;&#10;Service Bus events → Worker stitches sessions → Blob JSONL + UserProfile (SQL)&#10;Trigger engine evaluates rules → drafts nudge via LLM → SignalR push → SDK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontSize=11;fontColor=#065F46;align=center;verticalAlign=middle;arcSize=3;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
          <mxGeometry x="600" y="750" width="600" height="100" as="geometry" />
        </mxCell>

        <!-- Response back -->
        <mxCell id="a7" value="&lt;b&gt;Response&lt;/b&gt;  →  message + suggestions + relatedDocs  →  back to SDK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=11;fontStyle=1;fontColor=#92400E;align=center;verticalAlign=middle;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="600" y="900" width="600" height="60" as="geometry" />
        </mxCell>

