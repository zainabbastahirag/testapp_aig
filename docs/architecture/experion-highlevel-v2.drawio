        <!-- ═══════════════════════════════════════════════════════════ -->
        <mxCell id="controller" value="EXPERION CONTROLLER   (2 endpoints)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=14;fontStyle=1;fontColor=#92400E;align=left;verticalAlign=top;spacingLeft=20;spacingTop=10;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="1420" height="160" as="geometry" />
        </mxCell>

        <mxCell id="ep-track" value="&lt;b&gt;① POST /track&lt;/b&gt;&#10;&#10;Track activity events&#10;(passive observation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;fontSize=12;fontStyle=1;fontColor=#065F46;align=center;verticalAlign=middle;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="80" y="325" width="540" height="100" as="geometry" />
        </mxCell>

        <mxCell id="ep-process" value="&lt;b&gt;② POST /process&lt;/b&gt;&#10;&#10;Process chat / action / generation request&#10;Runs the 5 pipeline steps in sequence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=12;fontStyle=1;fontColor=#92400E;align=center;verticalAlign=middle;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="680" y="325" width="740" height="100" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- LANE 3 — EXPERION SERVICE (FLAT — ONE METHOD PER STEP) -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <mxCell id="service" value="EXPERION SERVICE   (flat — one method per step, no nesting)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;fontSize=14;fontStyle=1;fontColor=#92400E;align=left;verticalAlign=top;spacingLeft=20;spacingTop=10;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="1420" height="220" as="geometry" />
        </mxCell>

        <!-- /track step -->
        <mxCell id="m-track" value="&lt;b&gt;TrackActivityAsync()&lt;/b&gt;&#10;&#10;append events → Blob&#10;update profile → SQL&#10;then call RecoEngine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;fontSize=11;fontColor=#065F46;align=center;verticalAlign=middle;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="80" y="525" width="240" height="140" as="geometry" />
        </mxCell>

        <!-- /process steps -->
        <mxCell id="m-1" value="&lt;b&gt;1. EmbedQueryAsync()&lt;/b&gt;&#10;&#10;text → float[]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F59E0B;fontSize=11;fontColor=#78350F;align=center;verticalAlign=middle;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="380" y="525" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="m-2" value="&lt;b&gt;2. CheckSemanticCacheAsync()&lt;/b&gt;&#10;&#10;HIT → short-circuit ⤳" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontSize=11;fontColor=#065F46;align=center;verticalAlign=middle;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="570" y="525" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="m-3" value="&lt;b&gt;3. ClassifyIntentAsync()&lt;/b&gt;&#10;&#10;ACTION or GENERATION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F59E0B;fontSize=11;fontColor=#78350F;align=center;verticalAlign=middle;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="780" y="525" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="m-4a" value="&lt;b&gt;4a. RunActionAsync()&lt;/b&gt;&#10;&#10;dispatch action job" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;fontSize=11;fontColor=#7F1D1D;align=center;verticalAlign=middle;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="990" y="500" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m-4b" value="&lt;b&gt;4b. RunGenerationAsync()&lt;/b&gt;&#10;&#10;KB retrieval + LLM (RAG)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;fontSize=11;fontColor=#4C1D95;align=center;verticalAlign=middle;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="990" y="570" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m-5" value="&lt;b&gt;5. PersistAsync()&lt;/b&gt;&#10;&#10;blob: conv (2 lines)&#10;sql: cache + audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F59E0B;fontSize=11;fontColor=#78350F;align=center;verticalAlign=middle;arcSize=4;" vertex="1" parent="1">
