        <mxCell id="title" value="AG ONE Experion — Simplified Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1420" height="40" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="Two endpoints  ·  flat ExperionService with one method per step  ·  Blob = conversation + activity   SQL = cache + audit + profile + actions" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="40" y="55" width="1420" height="20" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- LANE 1 — FRONTEND -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <mxCell id="frontend" value="EXPERION JS SDK   (drop into any website)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=14;fontStyle=1;fontColor=#1E40AF;align=left;verticalAlign=top;spacingLeft=20;spacingTop=10;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="1420" height="160" as="geometry" />
        </mxCell>

        <mxCell id="sdk-track" value="&lt;b&gt;Activity Tracker&lt;/b&gt;&#10;&#10;pageview · click · scroll&#10;dwell · idle · gesture&#10;(batched every ~5s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontSize=12;fontColor=#1E3A8A;align=center;verticalAlign=middle;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="80" y="135" width="240" height="100" as="geometry" />
        </mxCell>

        <mxCell id="sdk-chat" value="&lt;b&gt;Chat / Gesture&lt;/b&gt;&#10;&#10;User asks a question OR&#10;circles a region of the page&#10;(synchronous)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;fontSize=12;fontColor=#1E3A8A;align=center;verticalAlign=middle;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="380" y="135" width="240" height="100" as="geometry" />
        </mxCell>

        <mxCell id="sdk-ui" value="&lt;b&gt;UI&lt;/b&gt;&#10;&#10;Sphere · chat sidebar · proactive nudge toast&#10;Receives push from server via SignalR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;fontSize=12;fontColor=#4C1D95;align=center;verticalAlign=middle;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="1080" y="135" width="340" height="100" as="geometry" />
