<mxfile host="app.diagrams.net" modified="2026-05-03T14:42:30.000Z" agent="cursor" version="24.0.0" type="device">
  <diagram name="Experion - Process flow" id="experion-flow-v2">
    <mxGraphModel dx="1500" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="POST /api/experion/process — call chain inside ExperionController.Process()" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1020" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="Each box = one method on ExperionService. The controller calls them one after another — no nesting." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1020" height="20" as="geometry" />
        </mxCell>

        <!-- Start -->
        <mxCell id="start" value="USER → POST /process&#10;{ sessionId, userMessage, capturedText? }" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3B82F6;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="100" width="340" height="60" as="geometry" />
        </mxCell>

        <!-- Step 1 -->
        <mxCell id="s1" value="&lt;b&gt;1. EmbedQueryAsync(query)&lt;/b&gt;&#10;&#10;input: text  →  output: float[] (e.g. 1536-dim)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F59E0B;fontSize=12;fontColor=#78350F;align=center;verticalAlign=middle;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="380" y="200" width="340" height="70" as="geometry" />
        </mxCell>

        <!-- Step 2 -->
        <mxCell id="s2" value="&lt;b&gt;2. CheckSemanticCacheAsync(tenant, embedding)&lt;/b&gt;&#10;&#10;cosine similarity over SemanticCache rows&#10;HIT (≥ 0.92) → return cached answer&#10;MISS → continue ↓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontSize=12;fontColor=#065F46;align=center;verticalAlign=middle;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="380" y="310" width="340" height="100" as="geometry" />
        </mxCell>

        <!-- Step 3 -->
        <mxCell id="s3" value="&lt;b&gt;3. ClassifyIntentAsync(tenant, query, embedding)&lt;/b&gt;&#10;&#10;hybrid score = embedding cosine + phrase Jaccard&#10;output: { intentType, actionKey?, scores }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F59E0B;fontSize=12;fontColor=#78350F;align=center;verticalAlign=middle;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="380" y="450" width="340" height="100" as="geometry" />
        </mxCell>

        <!-- Step 4a -->
        <mxCell id="s4a" value="&lt;b&gt;4a. RunActionAsync(req, userId, actionKey)&lt;/b&gt;&#10;&#10;dispatch ActionJob to action-queue&#10;return acknowledgment message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;fontSize=12;fontColor=#7F1D1D;align=center;verticalAlign=middle;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="80" y="600" width="340" height="100" as="geometry" />
        </mxCell>

        <!-- Step 4b -->
        <mxCell id="s4b" value="&lt;b&gt;4b. RunGenerationAsync(tenant, sid, userId, query)&lt;/b&gt;&#10;&#10;read history (Blob) + KB retrieval + LLM call&#10;return RAG answer + suggestion chips" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;fontSize=12;fontColor=#4C1D95;align=center;verticalAlign=middle;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="680" y="600" width="340" height="100" as="geometry" />
        </mxCell>

        <!-- Step 5 -->
        <mxCell id="s5" value="&lt;b&gt;5. PersistAsync(...)&lt;/b&gt;&#10;&#10;Blob: append 2 JSONL lines to conversations/...&#10;SQL: SemanticCache write-back (on miss + GENERATION) + AuditLog row" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F59E0B;fontSize=12;fontColor=#78350F;align=center;verticalAlign=middle;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="380" y="760" width="340" height="100" as="geometry" />
        </mxCell>

        <!-- End -->
        <mxCell id="end" value="ProcessResponse  →  SDK&#10;{ message, suggestions, intentType, cacheHit, pipeline[] }" style="ellipse;whiteSpace=wrap;html=1;fillColor=#10B981;strokeColor=#065F46;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="900" width="340" height="60" as="geometry" />
        </mxCell>

        <!-- Arrows -->
        <mxCell id="a-start-1" style="endArrow=classic;html=1;strokeColor=#0F172A;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="start" target="s1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a-1-2" style="endArrow=classic;html=1;strokeColor=#0F172A;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a-2-3" value="MISS" style="endArrow=classic;html=1;strokeColor=#0F172A;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#0F172A;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a-3-4a" value="ACTION" style="endArrow=classic;html=1;strokeColor=#EF4444;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#7F1D1D;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s3" target="s4a">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a-3-4b" value="GENERATION" style="endArrow=classic;html=1;strokeColor=#8B5CF6;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#4C1D95;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s3" target="s4b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a-4a-5" style="endArrow=classic;html=1;strokeColor=#0F172A;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="s4a" target="s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a-4b-5" style="endArrow=classic;html=1;strokeColor=#0F172A;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="s4b" target="s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a-5-end" style="endArrow=classic;html=1;strokeColor=#0F172A;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s5" target="end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- HIT shortcut: 2 → 5 directly -->
        <mxCell id="a-hit" value="HIT (skip 3 + 4)" style="endArrow=classic;html=1;strokeColor=#10B981;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#065F46;dashed=1;dashPattern=4 4;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="s2" target="s5">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="850" y="360" />
              <mxPoint x="850" y="810" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
